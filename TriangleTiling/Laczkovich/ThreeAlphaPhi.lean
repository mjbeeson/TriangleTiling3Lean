/-
Results of Section 5 ("A new invariant") of M. Beeson, *Triangle tiling: the case 3α + 2β = π*
(arXiv 1206.2229v4) that rest on `lemma:angles`.

Section 5's standing hypotheses are the hypotheses of each theorem here: `3α + 2β = π`, `ABC` is
tiled by copies of the tile `(α, β, γ)`, and `ABC` is not similar to the tile; `δ = α + β`.
Directions are measured from the direction of `AB` (`baseDir`), which is the normalization of
`lemma:Phisigns`.
-/
import TriangleTiling.Laczkovich.ThreeAlpha
import TriangleTiling.ThreeAlpha.PhiTiling

namespace TriangleTiling.ThreeAlpha

open Erdos634.Geometry Erdos634.Draft.TheoremPConditional
open Erdos634.Draft.LaczFormal (TileAngles)

variable {N : ℕ} (D : CongruentDissection N)

/-- **Lemma `lemma:incommensurable`.** `δ/π` is irrational. -/
theorem incommensurable {α β γ : ℝ} (hrel : 3 * α + 2 * β = Real.pi) (hT : TileAngles D α β γ)
    (hns : ¬ SimilarTM D) : IrrPi (α + β) := by
  exact delta_irr' (angles D hrel hT hns).1 hrel

/-- **Lemma `lemma:deltadirections`.** All differences of directions of edges of the tiling lie in
the subgroup of `ℝ/2πℤ` generated by `δ` and `π`, and the map `(n, ε) ↦ nδ + επ` is injective on
`ℤ × {0, 1}`. So, with the direction of `AB` as base direction `0`, every edge direction of the
tiling is `nδ + επ` for a unique pair `(n, ε)`, `ε ∈ {0, 1}`. -/
theorem deltadirections {α β γ : ℝ} (hrel : 3 * α + 2 * β = Real.pi) (hT : TileAngles D α β γ)
    (hns : ¬ SimilarTM D) :
    (∀ (i : Fin N) (k : Fin 3), ∃ n ε : ℤ, (ε = 0 ∨ ε = 1) ∧
      ((D.tile i).leftUnit k).angle
        = baseDir D + ((n * (α + β) + ε * Real.pi : ℝ) : Real.Angle)) ∧
    (∀ n n' ε ε' : ℤ, (ε = 0 ∨ ε = 1) → (ε' = 0 ∨ ε' = 1) →
      ((n * (α + β) + ε * Real.pi : ℝ) : Real.Angle)
        = ((n' * (α + β) + ε' * Real.pi : ℝ) : Real.Angle) → n = n' ∧ ε = ε') := by
  obtain ⟨a, b, c, h⟩ := threeAlphaData_of D hrel hT
  have hirr := (angles D hrel hT hns).1
  have hδ := delta_irr' hirr hrel
  refine ⟨fun i k => ?_, fun n n' ε ε' hε hε' e => ?_⟩
  · obtain ⟨n, e, he⟩ := edges_in_coset D hirr hrel h i k
    exact ⟨n, e % 2, emod_two_cases e, by rw [he, coset_norm]⟩
  · have := coset_eq hδ (θ₀ := 0) (n := n) (m := n') (e := ε) (f := ε')
      (by rw [zero_add, zero_add]; exact e)
    obtain ⟨hn, r, hr⟩ := this
    exact ⟨hn, by omega⟩

/-- **Lemma `lemma:Phitile`.** Let `t` be a tile. Its three edges have the same `ε`, and their
indices are `n`, `n + 1`, `n + 3` for the edges `a`, `b`, `c` (or `n`, `n - 1`, `n - 3` if `t` is a
reflected copy). Consequently `Φ₁(t) = (-1)^ε (a + b + c)` and `Φ₂(t) = (-1)^(n+ε) (a - b - c)`,
so `|Φ₁(t)| = a + b + c` and `|Φ₂(t)| = b + c - a`.

The edge `k` of a tile (from vertex `k` to vertex `k + 1`) is opposite vertex `k + 2`; it is the
`a` edge when the angle at `k + 2` is `α`. `ρ = -1` is the reflected case. -/
theorem Phitile {α β γ a b c : ℝ} (hrel : 3 * α + 2 * β = Real.pi)
    (hT : TileSides D α β γ a b c) (hns : ¬ SimilarTM D) (i : Fin N) :
    ∃ n ε ρ : ℤ, (ε = 0 ∨ ε = 1) ∧ (ρ = 1 ∨ ρ = -1) ∧
      (∀ k : Fin 3,
        ((D.tile i).angleAt (k + 2) = α → ((D.tile i).leftUnit k).angle
          = baseDir D + ((n * (α + β) + ε * Real.pi : ℝ) : Real.Angle)) ∧
        ((D.tile i).angleAt (k + 2) = β → ((D.tile i).leftUnit k).angle
          = baseDir D + (((n + ρ) * (α + β) + ε * Real.pi : ℝ) : Real.Angle)) ∧
        ((D.tile i).angleAt (k + 2) = γ → ((D.tile i).leftUnit k).angle
          = baseDir D + (((n + 3 * ρ) * (α + β) + ε * Real.pi : ℝ) : Real.Angle))) ∧
      PhiR (Phi1 (α + β) (baseDir D)) (D.tile i) = (ε.negOnePow : ℤ) * (a + b + c) ∧
      PhiR (Phi2 (α + β) (baseDir D)) (D.tile i) = ((n + ε).negOnePow : ℤ) * (a - b - c) ∧
      |PhiR (Phi1 (α + β) (baseDir D)) (D.tile i)| = a + b + c ∧
      |PhiR (Phi2 (α + β) (baseDir D)) (D.tile i)| = b + c - a := by
  have hT' : TileAngles D α β γ := by
    obtain ⟨σ, h0, h1, h2, -⟩ := hT
    exact ⟨σ, h0, h1, h2⟩
  have hγ := (tile_facts D hrel hT').2.2
  have h := threeAlphaData_of_sides D hrel hT
  subst hγ
  exact Phitile_irr D (angles D hrel hT' hns).1 hrel h i

/-- **Theorem `theorem:Mdef`.** There are integers `M₁`, `M₂` with `|M₁|, |M₂| ≤ N` and
`Mᵢ ≡ N (mod 2)` such that `Φ₁(∂ABC) = M₁ (a + b + c)` and `Φ₂(∂ABC) = M₂ (a - b - c)`. Indeed
`M₁ = Σⱼ (-1)^εⱼ` and `M₂ = Σⱼ (-1)^(nⱼ+εⱼ)`, summed over the tiles (`nⱼ`, `εⱼ` as in
`lemma:Phitile`). -/
theorem Mdef {α β γ a b c : ℝ} (hrel : 3 * α + 2 * β = Real.pi)
    (hT : TileSides D α β γ a b c) (hns : ¬ SimilarTM D) :
    ∃ n ε : Fin N → ℤ,
      (∀ j, (ε j = 0 ∨ ε j = 1) ∧
        PhiR (Phi1 (α + β) (baseDir D)) (D.tile j) = ((ε j).negOnePow : ℤ) * (a + b + c) ∧
        PhiR (Phi2 (α + β) (baseDir D)) (D.tile j)
          = ((n j + ε j).negOnePow : ℤ) * (a - b - c)) ∧
      ∃ M₁ M₂ : ℤ, M₁ = ∑ j, ((ε j).negOnePow : ℤ) ∧ M₂ = ∑ j, ((n j + ε j).negOnePow : ℤ) ∧
        |M₁| ≤ N ∧ |M₂| ≤ N ∧ M₁ ≡ N [ZMOD 2] ∧ M₂ ≡ N [ZMOD 2] ∧
        PhiR (Phi1 (α + β) (baseDir D)) D.target = M₁ * (a + b + c) ∧
        PhiR (Phi2 (α + β) (baseDir D)) D.target = M₂ * (a - b - c) := by
  have hT' : TileAngles D α β γ := by
    obtain ⟨σ, h0, h1, h2, -⟩ := hT
    exact ⟨σ, h0, h1, h2⟩
  exact Mdef_irr D (angles D hrel hT' hns).1 hrel (threeAlphaData_of_sides D hrel hT)

/-- **Remark `remark:Phi1iscoloring`.** `Φ₁` is the black-and-white coloring of Section 4: a tile
is black or white according to the value of `ε` on its edges (`lemma:Phitile`), with the tiles at
`B` having an edge on `AB` black; so `M₁` is the number of black tiles minus the number of white
tiles. -/
theorem Phi1iscoloring {α β γ a b c : ℝ} (hrel : 3 * α + 2 * β = Real.pi)
    (hT : TileSides D α β γ a b c) (hns : ¬ SimilarTM D) {ε : Fin N → ℤ}
    (hε : ∀ j, (ε j = 0 ∨ ε j = 1) ∧
      PhiR (Phi1 (α + β) (baseDir D)) (D.tile j) = ((ε j).negOnePow : ℤ) * (a + b + c)) :
    D.toDissection.ProperColouring (fun j => ((ε j).negOnePow : ℤ)) ∧
      ∀ i, AtBOnAB D i → ε i = 0 := by
  have hT' : TileAngles D α β γ := by
    obtain ⟨σ, h0, h1, h2, -⟩ := hT
    exact ⟨σ, h0, h1, h2⟩
  exact Phi1iscoloring_irr D (angles D hrel hT' hns).1 hrel (threeAlphaData_of_sides D hrel hT) hε

/-- **Lemma `lemma:Phisigns`.** Traverse `ABC` counterclockwise (`A`, `B`, `C` in counterclockwise
order), and normalize so that `Φᵢ = +1` on `AB`. Then, with the angles of `ABC` listed at
`A`, `B`, `C`, the signs of `Φ₁`, `Φ₂` on `AB`, `BC`, `CA` are

| angles of `ABC` | `Φ₁` | `Φ₂` |
|---|---|---|
| `(2α, β, α + β)` | `+ + -` | `+ - -` |
| `(β, 3α, β)` | `+ + +` | `+ + -` |
| `(α + β, α, α + β)` | `+ + -` | `+ + +` |
| `(α, α + 2β, α)` | `+ + +` | `+ + +` |
| `(2α, α, 2β)` | `+ + -` | `+ + -` | -/
theorem Phisigns {α β γ : ℝ} (hrel : 3 * α + 2 * β = Real.pi) (hT : TileAngles D α β γ)
    (hns : ¬ SimilarTM D) (hccw : 0 < D.target.det) :
    let Φ₁ := Phi1 (α + β) (baseDir D)
    let Φ₂ := Phi2 (α + β) (baseDir D)
    let AB := (D.target.leftUnit 0).angle
    let BC := (D.target.leftUnit 1).angle
    let CA := (D.target.leftUnit 2).angle
    let shape := fun x y z : ℝ =>
      D.target.angleAt 0 = x ∧ D.target.angleAt 1 = y ∧ D.target.angleAt 2 = z
    (Φ₁ AB = 1 ∧ Φ₂ AB = 1) ∧
    (shape (2 * α) β (α + β) → Φ₁ BC = 1 ∧ Φ₁ CA = -1 ∧ Φ₂ BC = -1 ∧ Φ₂ CA = -1) ∧
    (shape β (3 * α) β → Φ₁ BC = 1 ∧ Φ₁ CA = 1 ∧ Φ₂ BC = 1 ∧ Φ₂ CA = -1) ∧
    (shape (α + β) α (α + β) → Φ₁ BC = 1 ∧ Φ₁ CA = -1 ∧ Φ₂ BC = 1 ∧ Φ₂ CA = 1) ∧
    (shape α (α + 2 * β) α → Φ₁ BC = 1 ∧ Φ₁ CA = 1 ∧ Φ₂ BC = 1 ∧ Φ₂ CA = 1) ∧
    (shape (2 * α) α (2 * β) → Φ₁ BC = 1 ∧ Φ₁ CA = -1 ∧ Φ₂ BC = 1 ∧ Φ₂ CA = -1) := by
  intro Φ₁ Φ₂ AB BC CA shape
  have hirr := (angles D hrel hT hns).1
  have hδ := delta_irr' hirr hrel
  have hAB : AB = baseDir D + ((((0 : ℤ) : ℝ) * (α + β) + ((0 : ℤ) : ℝ) * Real.pi : ℝ) : Real.Angle) := by
    simp [AB, baseDir]
  have row := Phisigns_row D hirr hrel hccw
  refine ⟨⟨?_, ?_⟩, ?_, ?_, ?_, ?_, ?_⟩
  · show Phi1 (α + β) (baseDir D) AB = 1
    rw [hAB, phi1_eval hδ]; simp
  · show Phi2 (α + β) (baseDir D) AB = 1
    rw [hAB, phi2_eval hδ]; simp
  · rintro ⟨-, e1, e2⟩
    have := row 0 1 1 1 (u₁ := 1) (u₂ := -1) (v₁ := -1) (v₂ := -1)
      (by rw [e1]; push_cast; ring) (by rw [e2]; push_cast; ring)
      (by decide) (by decide) (by decide) (by decide)
    push_cast at this
    exact this
  · rintro ⟨-, e1, e2⟩
    have := row 3 0 0 1 (u₁ := 1) (u₂ := 1) (v₁ := 1) (v₂ := -1)
      (by rw [e1]; push_cast; ring) (by rw [e2]; push_cast; ring)
      (by decide) (by decide) (by decide) (by decide)
    push_cast at this
    exact this
  · rintro ⟨-, e1, e2⟩
    have := row 1 0 1 1 (u₁ := 1) (u₂ := -1) (v₁ := 1) (v₂ := 1)
      (by rw [e1]; push_cast; ring) (by rw [e2]; push_cast; ring)
      (by decide) (by decide) (by decide) (by decide)
    push_cast at this
    exact this
  · rintro ⟨-, e1, e2⟩
    have := row 1 2 1 0 (u₁ := 1) (u₂ := 1) (v₁ := 1) (v₂ := 1)
      (by rw [e1]; push_cast; ring) (by rw [e2]; push_cast; ring)
      (by decide) (by decide) (by decide) (by decide)
    push_cast at this
    exact this
  · rintro ⟨-, e1, e2⟩
    have := row 1 0 0 2 (u₁ := 1) (u₂ := -1) (v₁ := 1) (v₂ := -1)
      (by rw [e1]; push_cast; ring) (by rw [e2]; push_cast; ring)
      (by decide) (by decide) (by decide) (by decide)
    push_cast at this
    exact this

end TriangleTiling.ThreeAlpha
